{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "chrome": 54,
          "ie": 11
        }
      }
    ],
    ["@babel/preset-react", {
      "runtime": "automatic"
    }]
  ],
  "env": {
    "production": {
      "compact": true
    },
    "test": {
      "plugins": ["babel-plugin-transform-import-meta"]
    }
  }
}